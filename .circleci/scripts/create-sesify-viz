#!/usr/bin/env bash

set -x
set -e
set -u
set -o pipefail

# prepare artifacts dir
mkdir -p ./build-artifacts/deps-viz/

# generate viz
SESIFY_AUTOGEN=1 yarn build scripts:core:prod:background
npx lavamoat-viz --policiesDir ./lavamoat --policyNames browserify --dest ./build-artifacts/deps-viz/background
